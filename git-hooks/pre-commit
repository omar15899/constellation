#!/bin/sh
set -eu
source_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
  if "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$python" "$source_root/constellation.py" git-hook pre-commit "$@"
  fi
done
printf '%s\n' 'Constellation requires Python 3.11 or later.' >&2
exit 1
