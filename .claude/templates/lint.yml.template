# lint.yml — draft QuantOS CI workflow; configure before relying on this gate.
# The repo must declare uv, ruff, mypy and import-linter dependencies and configure
# .importlinter for its real packages. Adapt the mypy target to the repo layout.
# Missing configuration and failed checks must fail the job.

name: lint
on: [push, pull_request]

jobs:
  ruff-mypy-importlinter:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
      - name: ruff check
        run: uv run ruff check .
      - name: ruff format check
        run: uv run ruff format --check .
      - name: mypy strict
        run: uv run mypy packages/
      - name: import-linter
        run: uv run lint-imports
