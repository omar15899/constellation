# .importlinter — draft QuantOS forbidden-import contract.
#
# Replace <ROOT_PACKAGE>, <LAB_NAME> and <FORBIDDEN_PACKAGE> with importable
# package names from the repository and constellation tier registry. List every
# same-tier sibling and higher-tier package that this lab must not import.
# Repeat source_modules/root_packages entries for a multi-package repository.
# Keep repo-specific contracts; this draft does not infer the complete tier graph.
# Placeholders deliberately require configuration before lint-imports can pass.
#
# Format: https://import-linter.readthedocs.io/en/latest/contract_types/forbidden/

[importlinter]
root_packages =
    <ROOT_PACKAGE>
include_external_packages = True

[importlinter:contract:no-same-or-higher-tier]
name = <LAB_NAME> must not import same-tier siblings or higher tiers
type = forbidden
source_modules =
    <ROOT_PACKAGE>
forbidden_modules =
    <FORBIDDEN_PACKAGE>
