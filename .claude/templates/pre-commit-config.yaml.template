# .pre-commit-config.yaml — uniform QuantOS baseline (constellation template).
#
# Copied verbatim into a lab by `repo-bootstrap` / bootstrap_repo.sh. Activate
# with:  pre-commit install
#
# Layout-agnostic by design: ruff and ruff-format read the lab's own
# pyproject [tool.ruff] and discover files themselves, so this works for both
# `src/` and `packages/` layouts without edits.
#
# The gates that depend on layout/venv (mypy --strict, import-linter) are left
# as opt-in blocks at the bottom — uncomment and set <PKG_DIR> (src/ or
# packages/) once the lab's package tree and .importlinter contracts are live.
# An empty .importlinter makes `lint-imports` error, so only enable it after
# root_packages are declared.

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-merge-conflict
      - id: check-added-large-files
      - id: mixed-line-ending
        args: ["--fix=lf"]

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.15.12
    hooks:
      # Formatter — no-op if already formatted.
      - id: ruff-format
      # Linter — no --fix so violations stay visible and intentional.
      - id: ruff
        args: ["--no-fix"]

  # --- Opt-in per-lab gates (uncomment once the package tree is ready) -------
  #
  # mypy --strict over the package tree. Set <PKG_DIR> to src/ or packages/.
  # Uses whatever `mypy` is on PATH (the shared ~/GitHub/.venv, per ADR-0033);
  # BacktestLab overrides entry to .venv/bin/mypy (project-local venv).
  # - repo: local
  #   hooks:
  #     - id: mypy
  #       name: mypy (strict)
  #       language: system
  #       entry: mypy
  #       pass_filenames: false
  #       args: ["--config-file=pyproject.toml", "<PKG_DIR>"]
  #       files: ^<PKG_DIR>/.*\.py$
  #
  # import-linter tier contracts. Enable ONLY after .importlinter declares
  # root_packages — an empty contract makes lint-imports error.
  # - repo: local
  #   hooks:
  #     - id: lint-imports
  #       name: import-linter (tier discipline)
  #       language: system
  #       entry: lint-imports
  #       pass_filenames: false
  #       files: \.py$
