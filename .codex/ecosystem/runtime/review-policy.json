{
  "schema_version": 2,
  "allow_quick_code": true,
  "modes": {
    "quick": {"reviewers": 1, "focus": {"correctness": 1}},
    "standard": {"reviewers": 3, "focus": {"correctness": 3}},
    "deep": {"reviewers": 5, "focus": {"correctness": 3, "security": 2}}
  },
  "documentation_extensions": [".md", ".rst", ".txt"],
  "documentation_names": ["LICENSE", "NOTICE"],
  "deep_patterns": [
    ".github/**", "**/.github/**",
    "**/security/**", "**/auth/**",
    "**/credentials/**", "**/billing/**",
    "**/install/**", "**/installer/**",
    "**/installers/**", "security/**",
    "auth/**", "credentials/**",
    "billing/**", "install/**",
    "installer/**", "installers/**",
    "**/install.*", "install.*",
    "**/auth.*", "auth.*",
    "**/security.*", "security.*",
    "**/billing.*", "billing.*",
    "**/credentials.*", "credentials.*",
    "AGENTS.md", "**/AGENTS.md",
    "REVIEW.md", "**/REVIEW.md",
    ".claude/**", ".codex/README.md",
    "**/.codex/README.md", ".codex/PROJECT.md",
    "**/.codex/PROJECT.md", ".codex/WORKSPACE.md",
    "**/.codex/WORKSPACE.md", ".codex/RESEARCH.md",
    "**/.codex/RESEARCH.md", ".codex/QUANT_RESEARCH.md",
    "**/.codex/QUANT_RESEARCH.md", ".codex/KNOWLEDGE.md",
    "**/.codex/KNOWLEDGE.md", ".codex/profiles/**",
    "**/.codex/profiles/**", ".codex/git-hooks/**",
    "**/.codex/git-hooks/**", ".codex/hooks/**",
    "**/.codex/hooks/**", "ecosystem/runtime/**",
    "**/ecosystem/runtime/**", "ecosystem/vault/**",
    "**/ecosystem/vault/**", "ecosystem/agents/**",
    "**/ecosystem/agents/**", "ecosystem/manifests/**",
    "**/ecosystem/manifests/**", "ecosystem/references/**",
    "**/ecosystem/references/**", "AGENTS.override.md",
    "**/AGENTS.override.md", "CLAUDE.md",
    "**/CLAUDE.md", "SKILL.md",
    "**/SKILL.md", ".agents/**",
    "**/.agents/**", "**/.claude/**",
    "ecosystem/*.py", "**/ecosystem/*.py",
    "skills/**", "**/skills/**",
    "ecosystem/locales/**", "**/ecosystem/locales/**",
    "ecosystem/docs/migrations.md", "**/ecosystem/docs/migrations.md",
    "ecosystem/docs/updates.md", "**/ecosystem/docs/updates.md",
    "ecosystem/docs/progress.md", "**/ecosystem/docs/progress.md",
    "ecosystem/docs/windows.md", "**/ecosystem/docs/windows.md",
    "ecosystem/README.md", "**/ecosystem/README.md"
  ]
}
