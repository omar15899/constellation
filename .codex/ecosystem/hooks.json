{
  "description": "Optional guards for explicitly registered Constellation tasks. Requires native trust; not a sandbox or completion certificate.",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/ecosystem/hooks.py\" UserPromptSubmit", "timeout": 10}]}],
    "PreToolUse": [{"matcher": "^(?:[A-Za-z0-9_]+[.:])*(?:apply_patch|Edit|Write)$", "hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/ecosystem/hooks.py\" PreToolUse", "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/ecosystem/hooks.py\" SubagentStart", "timeout": 10}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/ecosystem/hooks.py\" SubagentStop", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/ecosystem/hooks.py\" Stop", "timeout": 10}]}]
  }
}
