{
  "description": "Shared Constellation research contracts through native Claude events; project adapters retain explicit ownership.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3", "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/ecosystem/claude_hooks.py", "SessionStart"], "timeout": 15}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3", "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/ecosystem/claude_hooks.py", "UserPromptSubmit"], "onFailure": "block", "timeout": 15}]}],
    "PreToolUse": [{"matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$", "hooks": [{"type": "command", "command": "python3", "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/ecosystem/claude_hooks.py", "PreToolUse"], "onFailure": "block", "timeout": 15}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3", "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/ecosystem/claude_hooks.py", "SubagentStart"], "timeout": 15}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3", "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/ecosystem/claude_hooks.py", "SubagentStop"], "timeout": 15}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3", "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/ecosystem/claude_hooks.py", "Stop"], "timeout": 15}]}]
  }
}
