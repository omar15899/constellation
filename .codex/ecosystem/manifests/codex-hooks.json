{
  "description": "Optional guards for explicitly registered Constellation tasks. Requires native trust; not a sandbox or completion certificate.",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"${CODEX_HOME:-$HOME/.codex}/constellation/run\" UserPromptSubmit", "timeout": 60}]}],
    "PreToolUse": [{"matcher": "^(?:[A-Za-z0-9_]+[.:])*(?:apply_patch|Edit|Write)$", "hooks": [{"type": "command", "command": "\"${CODEX_HOME:-$HOME/.codex}/constellation/run\" PreToolUse", "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "\"${CODEX_HOME:-$HOME/.codex}/constellation/run\" SubagentStart", "timeout": 10}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"${CODEX_HOME:-$HOME/.codex}/constellation/run\" SubagentStop", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"${CODEX_HOME:-$HOME/.codex}/constellation/run\" Stop", "timeout": 10}]}]
  }
}
