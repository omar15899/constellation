{
  "description": "Constellation: check upstream, guide native workers, guard declared patches, require reviewed and published closure.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'exec python3 \"$HOME/GitHub/.codex/workflow.py\" hook prompt'",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'exec python3 \"$HOME/GitHub/.codex/workflow.py\" hook pre-tool'",
            "timeout": 10
          }
        ],
        "matcher": "^(?:[A-Za-z0-9_]+[.:])*apply_patch$"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'exec python3 \"$HOME/GitHub/.codex/workflow.py\" hook subagent-start'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'exec python3 \"$HOME/GitHub/.codex/workflow.py\" hook stop'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
